import io, planner.

main =>
    % Read one ground Picat term ending in a period.
    Request = read_term(),
    if valid_request(Request) then
        Request = $solve(Start, Goal),
        if best_plan_unbounded($state(Start, Goal), Moves, Cost) then
            foreach (Move in Moves)
                println(Move)
            end,
            printf("Total actions: %w\n", Cost)
        else
            println("No sorting plan")
        end
    else
        println("Invalid input. Expected solve(Start, Goal)."),
        throw(invalid_inventory_request)
    end.

valid_request(solve(Start, Goal)) =>
    ground($solve(Start, Goal)),
    list(Start), list(Goal),
    Player = length(Start),
    Player >= 2, length(Goal) == Player,
    foreach (R in 1..Player)
        list(Start[R]), list(Goal[R]),
        length(Start[R]) == length(Goal[R]),
        foreach (S in 1..length(Start[R]))
            valid_slot(Start[R,S]),
            valid_slot(Goal[R,S])
        end
    end,
    sort([Slot : Row in Start, Slot in Row, Slot != empty]) ==
        sort([Slot : Row in Goal, Slot in Row, Slot != empty]).

valid_slot(empty) => true.
valid_slot(stack(Item, Count)) => atom(Item), integer(Count), Count > 0.

% Carry the immutable request data in the state passed to the planner.
final(state(Rows, Goal)) => Rows == Goal.

action(state(Rows, Goal), NextState, Move, Cost) ?=>
    Player = length(Rows),
    member(From, 1..Player),
    member(Source, 1..length(Rows[From])),
    Stack = Rows[From, Source],
    Stack = $stack(_, _),
    if From == Player then
        member(To, 1..(Player-1)),
        Move = $deposit(Source, To, Destination)
    else
        To = Player,
        Move = $take(From, Source, Destination)
    end,
    member(Destination, 1..length(Rows[To])),
    Rows[To, Destination] == empty,
    % Rebuild the two changed rows so backtracking retains the original state.
    Next = [next_row(Rows[R], R, From, Source, To, Destination, Stack) : R in 1..Player],
    NextState = $state(Next, Goal),
    Cost = 1.

next_row(Row, R, From, Source, To, Destination, Stack) = Next =>
    if R == From then
        Next = [replace_slot(Row[S], S, Source, empty) : S in 1..length(Row)]
    elseif R == To then
        Next = [replace_slot(Row[S], S, Destination, Stack) : S in 1..length(Row)]
    else
        Next = Row
    end.

replace_slot(_, S, Target, Value) = Value, S == Target => true.
replace_slot(Previous, _, _, _) = Previous.
